# Azure Configuration
azure_subscription_id = "12345678-1234-1234-1234-123456789abc"
azure_tenant_id       = "12345678-1234-1234-1234-123456789abc"
resource_group_name   = "mtln-agent-rg"
location              = "eastus"

# Resource Naming
name = "mtln-agent"

# Matillion Configuration
matillion_cloud_region = "eu1"
account_id             = "your-matillion-account-id"
agent_id               = "your-unique-agent-id"
client_id              = "your-oauth-client-id"
client_secret          = "your-oauth-client-secret"
export_logs            = "true"
# proxy_protocol_http  = "http"
# proxy_protocol_https = "https"

# Python Script and Bash Script on the runner. Set to true to stop both: they then fail at Run
# with "Cannot run program /python-script-disabled-on-this-runner". Script Pushdown still works.
disable_script_execution = false

# Agent sizing — small (default) | medium | large | xlarge
# small  = 1 vCPU / 4 GiB   on D4
# medium = 2 vCPU / 8 GiB   on D4
# large  = 4 vCPU / 16 GiB  on D4 (whole profile)
# xlarge = 8 vCPU / 32 GiB  on D8 (whole profile)
runner_size = "small"

# Optional overrides (commented out — uncomment to bypass the size map):
# workload_profile_type = "E4"     # e.g. memory-optimized E-series
# container_cpu         = "1.0"
# container_memory      = "8Gi"

# workload_profile_max_count instances must hold all replicas, plus the script runner when
# enabled. large and xlarge need one instance per replica.
replica_count              = 2
workload_profile_max_count = 1
zone_redundancy_enabled    = false

# Storage replication. ZRS keeps copies in separate availability zones and is
# what a zone-redundant environment should be paired with; LRS keeps one copy in
# one zone. Recommended for new deployments.
#
# On a storage account that already holds data this is an Azure conversion, not
# a Terraform edit — see the module readme before changing it in place.
storage_account_replication_type = "ZRS"

# Optional: outbound egress control
# enable_nat_gateway       = false
# nat_gateway_idle_timeout = 10

# Optional: public IPs allowed through the Key Vault firewall, so an operator can
# add the secrets the runner reads. Empty keeps the vault closed outside the VNet.
# key_vault_allowed_ip_ranges = ["203.0.113.10"]

# Key Vault Administrator. Unset, the identity that runs terraform apply is the
# administrator, so the grant moves to whoever applies next. Set object IDs of the
# people, groups or CI service principal that should administer the vault. Include
# the identity that applies, or it loses vault administration on the next apply.
# key_vault_administrator_principal_ids = ["00000000-0000-0000-0000-000000000000"]

# Optional
container_image_url = "matillion.azurecr.io/cloud-agent:current"

tags = {
  Environment = "production"
  Project     = "mtln-agent"
}