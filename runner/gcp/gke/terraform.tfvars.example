# =============================================================================
# GCP GKE Deployment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Configuration
# -----------------------------------------------------------------------------

project_id = "your-gcp-project-id"   # GCP project ID
region     = "us-central1"            # GCP region
name       = "matillion-runner"        # Name prefix for all resources

# Resource labels applied to all GCP resources
labels = {
  environment = "test"
  project     = "matillion-runner"
  team        = "data-platform"
  managed_by  = "terraform"
}

# -----------------------------------------------------------------------------
# GKE Cluster Configuration
# -----------------------------------------------------------------------------

desired_node_count     = 2             # Nodes per zone (autoscaler adds up to +2 per zone)
machine_type           = "e2-standard-4"  # 4 vCPU, 16 GB RAM
node_disk_size         = 100           # Node boot disk size in GB

# Cluster access configuration
is_private_cluster     = true          # true = private nodes (recommended for production)
master_ipv4_cidr_block = "172.16.0.0/28"  # Control-plane network CIDR
authorized_ip_ranges   = ["0.0.0.0/0"]   # CIDR blocks allowed to access GKE API
                                          # IMPORTANT: Restrict this in production!
                                          # Example: ["203.0.113.0/24", "10.0.0.0/8"]

# -----------------------------------------------------------------------------
# Runner secret creator role
# -----------------------------------------------------------------------------

# Leave unset to let Terraform create a custom role for this deployment.
# Set it to a role created beforehand (see README, "Pre-creating the runner
# secret creator role") so the deployer does not need iam.roles.create.
# existing_runner_secret_creator_role_id = "projects/your-gcp-project-id/roles/matillion_runner_secret_creator"

# -----------------------------------------------------------------------------
# Networking Configuration
# -----------------------------------------------------------------------------

# Recommended when is_private_cluster = true, and required when this module
# creates the VPC (existing_network unset): allows nodes to pull container
# images and reach external services without needing public IPs.
enable_cloud_nat = true

# By default a new VPC/subnet is created. To use an existing one instead,
# set existing_network below (the subnet must already have pod/service
# secondary IP ranges provisioned).
# Example size for subnets: subnet /24, pods /16, services /20
# existing_network = {
#   network_id                     = "your-vpc"
#   subnet_id                      = "your-subnet"
#   pod_secondary_range_name       = "pods"
#   services_secondary_range_name  = "services"
# }

# Optional node service account created outside Terraform: see "Pre-creating the node service account" in README.md.
# existing_node_service_account_email = "runner-nodes@your-gcp-project-id.iam.gserviceaccount.com"

# Optional runner service account created outside Terraform: see "Pre-creating the runner service account" in README.md.
# existing_runner_workload_service_account_email = "runner-workload@your-gcp-project-id.iam.gserviceaccount.com"

# Only with existing_node_service_account_email, after an IAM admin has granted the node account
# roles/logging.logWriter, roles/monitoring.metricWriter and roles/monitoring.viewer.
# grant_node_project_roles = false

# =============================================================================
# Configuration Examples
# =============================================================================

# Example 1: Development (public nodes, no Cloud NAT)
# ---------------------------------------------------
# is_private_cluster   = false
# enable_cloud_nat     = false
# authorized_ip_ranges = ["<your-office-ip>/32"]
# desired_node_count   = 2             # per zone

# Example 2: Production (private nodes + Cloud NAT)
# -------------------------------------------------
# is_private_cluster   = true
# enable_cloud_nat     = true
# authorized_ip_ranges = ["10.0.0.0/8", "203.0.113.0/24"]
# desired_node_count   = 3             # per zone
# machine_type         = "n2-standard-4"
